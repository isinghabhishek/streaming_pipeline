# =============================================================================
# Real-Time Streaming Pipeline — Environment Variables
# Copy this file to .env and fill in the values before running docker compose.
# =============================================================================

# -----------------------------------------------------------------------------
# Kafka (KRaft mode)
# -----------------------------------------------------------------------------

# Comma-separated list of Kafka broker addresses used by all components.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Kafka cluster ID (generate once with: kafka-storage.sh random-uuid)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# -----------------------------------------------------------------------------
# Schema Registry
# -----------------------------------------------------------------------------

# Base URL of the Confluent Schema Registry REST API.
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# -----------------------------------------------------------------------------
# Producer
# -----------------------------------------------------------------------------

# Source type to ingest from. One of: rest_api | iot_simulator | websocket
SOURCE_TYPE=iot_simulator

# Endpoint URL for REST API or WebSocket sources. Ignored for iot_simulator.
SOURCE_URL=

# How often the producer polls the source, in milliseconds. Default: 1000
POLL_INTERVAL_MS=1000

# -----------------------------------------------------------------------------
# Flink Stream Processor
# -----------------------------------------------------------------------------

# Kafka topic the Flink job consumes from.
KAFKA_TOPIC=iot_simulator.events

# Tumbling window size in seconds. Valid range: 10–300. Default: 60
WINDOW_SIZE_SECONDS=60

# Flink checkpoint interval in milliseconds. Default: 10000
CHECKPOINT_INTERVAL_MS=10000

# Path inside the Flink containers where Delta Lake tables are written.
DELTA_TABLE_PATH=/data/delta

# Number of Flink TaskManager task slots.
FLINK_TASK_SLOTS=2

# -----------------------------------------------------------------------------
# Spark / Delta Lake
# -----------------------------------------------------------------------------

# Spark master URL used by the Thrift Server and storage init script.
SPARK_MASTER=local[*]

# Directory on the Spark container where Delta tables are stored.
DELTA_STORAGE_PATH=/data/delta

# -----------------------------------------------------------------------------
# dbt
# -----------------------------------------------------------------------------

# Spark Thrift Server host for dbt-spark connections.
DBT_SPARK_HOST=spark-thrift

# Spark Thrift Server port.
DBT_SPARK_PORT=10000

# dbt target schema / database name.
DBT_SCHEMA=pipeline_dbt

# How often the dbt cron job runs (cron expression). Default: every 5 minutes.
DBT_CRON_SCHEDULE=*/5 * * * *

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------

# Grafana admin username.
GF_SECURITY_ADMIN_USER=admin

# Grafana admin password. Change before exposing to any network.
GF_SECURITY_ADMIN_PASSWORD=changeme

# Grafana server root URL (used for alert notifications).
GF_SERVER_ROOT_URL=http://localhost:3000
