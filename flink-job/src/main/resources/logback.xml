<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!--
    Structured JSON logging for the Flink stream processor.
    Output format satisfies Requirement 9.1:
      { "timestamp": "...", "component": "...", "level": "...", "message": "..." }
  -->

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
      <layout class="ch.qos.logback.contrib.json.classic.JsonLayout">
        <jsonFormatter class="ch.qos.logback.contrib.jackson.JacksonJsonFormatter">
          <prettyPrint>false</prettyPrint>
        </jsonFormatter>
        <!-- Include all standard MDC keys and timestamp -->
        <appendLineSeparator>true</appendLineSeparator>
        <timestampFormat>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampFormat>
        <timestampFormatTimezoneId>UTC</timestampFormatTimezoneId>
      </layout>
    </encoder>
  </appender>

  <!-- Root logger -->
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>

  <!-- Reduce verbosity from Flink internals -->
  <logger name="org.apache.flink" level="WARN"/>
  <logger name="org.apache.kafka" level="WARN"/>
  <logger name="io.delta"         level="WARN"/>
  <logger name="org.apache.hadoop" level="WARN"/>

  <!-- Our pipeline code at INFO -->
  <logger name="com.pipeline" level="INFO"/>

</configuration>
